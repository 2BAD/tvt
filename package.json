{
  "name": "@2bad/tvt",
  "version": "2.1.0",
  "description": "TypeScript SDK for TVT and rebadged OEM CCTV devices: login, live H.264 streaming, snapshots, alarm monitoring, RTSP, and device control over the NET_SDK protocol",
  "keywords": [
    "tvt",
    "ipc",
    "cctv",
    "nvr",
    "dvr",
    "ip-camera",
    "surveillance",
    "rtsp",
    "net-sdk",
    "live-stream",
    "h264",
    "snapshot",
    "alarm",
    "koffi",
    "ffi"
  ],
  "homepage": "https://github.com/2BAD/tvt#readme",
  "bugs": {
    "url": "https://github.com/2BAD/tvt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2BAD/tvt.git"
  },
  "license": "MIT",
  "author": "2BAD (https://github.com/2BAD)",
  "contributors": [
    {
      "name": "Jason Hyde",
      "email": "github@2bad.me",
      "url": "https://github.com/mrhyde"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/device.d.ts",
        "default": "./build/device.js"
      }
    }
  },
  "files": [
    "bin",
    "build"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-p check:**",
    "check:code": "oxlint ./source",
    "check:format": "oxfmt --check ./source",
    "check:types": "tsc --noEmit",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./source",
    "fix:format": "oxfmt ./source",
    "prepublishOnly": "run-s build",
    "preversion": "run-s check test build",
    "test": "vitest run",
    "test:integration": "vitest run integration --coverage",
    "test:unit": "vitest run unit --coverage"
  },
  "dependencies": {
    "debug": "4.4.3",
    "koffi": "2.16.3",
    "p-series": "3.0.0"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/debug": "4.1.13",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.8.1",
    "pnpm": "11.24.0"
  }
}

{
  "name": "@2bad/tvt",
  "version": "2.0.0",
  "description": "",
  "keywords": ["tvt", "ipc", "cctv"],
  "homepage": "https://github.com/2BAD/tvt#readme",
  "bugs": {
    "url": "https://github.com/2BAD/tvt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2BAD/tvt.git"
  },
  "license": "MIT",
  "author": "2BAD (https://github.com/2BAD)",
  "contributors": [
    {
      "name": "Jason Hyde",
      "email": "github@2bad.me",
      "url": "https://github.com/mrhyde"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/device.d.ts",
        "default": "./build/device.js"
      }
    }
  },
  "files": ["bin", "build"],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "run-p build:*",
    "postbuild": "tsfix",
    "build:swc": "swc ./source -d ./build --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "check": "run-p check:**",
    "check:code": "oxlint ./source",
    "check:format": "oxfmt --check ./source",
    "check:types": "tsc --noEmit",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./source",
    "fix:format": "oxfmt ./source",
    "prepublishOnly": "run-s build",
    "preversion": "run-s check test build",
    "test": "vitest run",
    "test:integration": "vitest run integration --coverage",
    "test:unit": "vitest run unit --coverage"
  },
  "dependencies": {
    "debug": "4.4.3",
    "koffi": "2.16.3",
    "p-series": "3.0.0"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@2bad/tsfix": "1.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.46",
    "@types/debug": "4.1.13",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.5.0",
    "pnpm": "11.17.0"
  }
}
